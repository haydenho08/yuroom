# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Postgres (read by docker-compose) ---
POSTGRES_DB=yuroom
POSTGRES_USER=yuroom
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Backend (read by Spring Boot from the environment) ---
DATABASE_URL=jdbc:postgresql://localhost:5433/yuroom?reWriteBatchedInserts=true
DATABASE_USERNAME=yuroom
DATABASE_PASSWORD=change-me

# Ingestion. Source FILE reads a CSV export; HTTP fetches a URL we have permission to use.
INGESTION_ENABLED=true
INGESTION_SOURCE=FILE
INGESTION_FILE_PATH=../data/sample/timetable-sample.csv
INGESTION_RUN_ON_STARTUP=true
# Only set this to a URL York has approved. The User-Agent is fixed to "YURoom student project".
INGESTION_HTTP_URL=
